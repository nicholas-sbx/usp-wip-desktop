{
  "name": "uspwip-desktop",
  "version": "1.0.0",
  "description": "USPWIP Desktop",
  "main": "./out/main/index.js",
  "author": "Nicholas",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mjs\"",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:x11": "electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && npm run build:helper && electron-builder --linux",
    "build:helper": "make -C native/wayland-overlay"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@vueuse/core": "^13.9.0",
    "obscenity": "^0.4.6",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  }
}
